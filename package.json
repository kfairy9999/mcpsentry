{
  "name": "mcpsentry",
  "version": "0.1.0",
  "private": true,
  "description": "CLI and GitHub Action that statically and dynamically audits MCP servers for over-broad tools, dishonest annotations, secrets, unsafe sinks, and dependency CVEs.",
  "type": "module",
  "license": "MIT",
  "author": "Kevin Fairley",
  "homepage": "https://github.com/kfairley9999/mcpsentry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kfairley9999/mcpsentry.git"
  },
  "bugs": {
    "url": "https://github.com/kfairley9999/mcpsentry/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "scanner",
    "sarif",
    "static-analysis"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mcpsentry": "./dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
